---
import type { CheckList } from '~/data/checklists';

interface Props {
  list: CheckList;
}
const { list } = Astro.props;
const kindLabel = {
  einmalig: 'einmalig',
  wiederkehrend: 'vor jedem Mal',
  referenz: 'Referenz',
}[list.kind];
---

<section class="cl" data-checklist={list.id} id={list.id}>
  <span class="tick tl" aria-hidden="true"></span>
  <span class="tick br" aria-hidden="true"></span>

  <header class="cl-head">
    <div>
      <h3>{list.title}</h3>
      <p class="intro">{list.intro}</p>
    </div>
    <div class="cl-meta">
      <span class="count" data-count>0/{list.items.length}</span>
      <span class="mono-label">{kindLabel}</span>
    </div>
  </header>

  <ul class="items">
    {
      list.items.map((item) => (
        <li>
          <label>
            <input type="checkbox" data-item={item.id} />
            <span class="box" aria-hidden="true" />
            <span class="txt">
              {item.text}
              {item.note && <span class="note">{item.note}</span>}
            </span>
          </label>
        </li>
      ))
    }
  </ul>

  <footer class="cl-foot">
    <button class="btn" type="button" data-reset>Zurücksetzen</button>
    <span class="hint mono-label" data-saved></span>
  </footer>
</section>

<style>
  .cl {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
  }
  .tick { position: absolute; width: 7px; height: 7px; border: 0 solid var(--line-strong); }
  .tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .cl-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s5);
    padding: var(--s4) var(--s5);
    border-bottom: 1px solid var(--line);
    background: var(--panel-sunk);
  }
  h3 { font-size: var(--fs-h3); }
  .intro {
    margin-top: var(--s2);
    max-width: 60ch;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .cl-meta { text-align: right; display: grid; gap: 2px; flex: none; }
  .count {
    font-family: var(--font-mono);
    font-size: var(--fs-lead);
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }
  .cl[data-complete] .count { color: var(--gps); }

  .items { list-style: none; margin: 0; padding: 0; }
  .items li { border-bottom: 1px solid var(--line-faint); }
  .items li:last-child { border-bottom: none; }

  label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s3);
    align-items: start;
    padding: var(--s3) var(--s5);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  label:hover { background: var(--panel-hi); }

  input { position: absolute; opacity: 0; width: 0; height: 0; }

  /* Eckiges Kaestchen, kein Rundfunk */
  .box {
    width: 13px;
    height: 13px;
    margin-top: 4px;
    border: 1px solid var(--line-strong);
    position: relative;
    flex: none;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  input:focus-visible + .box { outline: 1px solid var(--accent); outline-offset: 2px; }
  input:checked + .box { background: var(--gps); border-color: var(--gps); }
  input:checked + .box::after {
    content: '';
    position: absolute;
    left: 3px; top: 0px;
    width: 4px; height: 8px;
    border: solid #000;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .txt { font-size: var(--fs-small); color: var(--text-dim); }
  input:checked ~ .txt { color: var(--muted-deep); text-decoration: line-through; }
  .note {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--muted-deep);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .cl-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s3) var(--s5);
    border-top: 1px solid var(--line);
  }
  .hint { color: var(--muted-deep); }

  @media (max-width: 600px) {
    .cl-head { flex-direction: column; gap: var(--s3); }
    .cl-meta { text-align: left; }
    label { padding: var(--s3) var(--s4); }
  }
</style>

<script>
  // Zustand pro Liste im localStorage. Faellt der Speicher aus (privates Fenster,
  // blockierte Site-Daten), funktioniert die Liste weiter — nur ohne Gedaechtnis.
  const PREFIX = 'voidfpv:check:';

  for (const el of document.querySelectorAll<HTMLElement>('[data-checklist]')) {
    const id = el.dataset.checklist!;
    const key = PREFIX + id;
    const boxes = Array.from(el.querySelectorAll<HTMLInputElement>('input[data-item]'));
    const counter = el.querySelector<HTMLElement>('[data-count]')!;
    const saved = el.querySelector<HTMLElement>('[data-saved]')!;
    const reset = el.querySelector<HTMLButtonElement>('[data-reset]')!;

    const read = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(key) ?? '[]');
      } catch {
        return [];
      }
    };
    const write = (ids: string[]) => {
      try {
        localStorage.setItem(key, JSON.stringify(ids));
        saved.textContent = ids.length ? 'lokal gespeichert' : '';
      } catch {
        saved.textContent = 'nicht speicherbar';
      }
    };

    const render = () => {
      const done = boxes.filter((b) => b.checked).length;
      counter.textContent = `${done}/${boxes.length}`;
      el.toggleAttribute('data-complete', done === boxes.length && done > 0);
    };

    const initial = read();
    for (const b of boxes) b.checked = initial.includes(b.dataset.item!);
    render();
    if (initial.length) saved.textContent = 'lokal gespeichert';

    el.addEventListener('change', () => {
      write(boxes.filter((b) => b.checked).map((b) => b.dataset.item!));
      render();
    });

    reset.addEventListener('click', () => {
      for (const b of boxes) b.checked = false;
      write([]);
      render();
    });
  }
</script>
