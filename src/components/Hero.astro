---
/**
 * OSD-Rahmen der Startseite: Eckklammern, Fadenkreuz, einmalige Sweep-Line.
 * Bewegung nur beim Laden und nur, wenn der Nutzer sie nicht abbestellt hat.
 */
interface Props {
  status: string;
  statusTone: 'ok' | 'warn' | 'alert';
  headline: string;
  sub: string;
}
const { status, statusTone, headline, sub } = Astro.props;
---

<div class="hero">
  <span class="br tl" aria-hidden="true"></span>
  <span class="br tr" aria-hidden="true"></span>
  <span class="br bl" aria-hidden="true"></span>
  <span class="br br2" aria-hidden="true"></span>
  <span class="sweep" aria-hidden="true"></span>

  <svg class="cross" viewBox="0 0 40 40" aria-hidden="true">
    <path d="M20 6v9M20 25v9M6 20h9M25 20h9" stroke="currentColor" stroke-width="1" fill="none" />
    <circle cx="20" cy="20" r="3.5" stroke="currentColor" stroke-width="1" fill="none" />
  </svg>

  <div class="inner">
    <div class:list={['status', `t-${statusTone}`]}>
      <span class="dot" aria-hidden="true"></span>
      <span>{status}</span>
    </div>
    <h1>{headline}</h1>
    <p class="sub">{sub}</p>
    <div class="actions"><slot /></div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--s8) var(--s7);
    background:
      linear-gradient(180deg, rgba(255, 176, 0, 0.03), transparent 60%),
      var(--panel-sunk);
    border: 1px solid var(--line);
    margin-bottom: var(--s7);
  }

  /* Eckklammern */
  .br {
    position: absolute;
    width: 14px; height: 14px;
    border: 0 solid var(--accent);
    opacity: 0.85;
  }
  .tl  { top: 10px; left: 10px; border-top-width: 1px; border-left-width: 1px; }
  .tr  { top: 10px; right: 10px; border-top-width: 1px; border-right-width: 1px; }
  .bl  { bottom: 10px; left: 10px; border-bottom-width: 1px; border-left-width: 1px; }
  .br2 { bottom: 10px; right: 10px; border-bottom-width: 1px; border-right-width: 1px; }

  .cross {
    position: absolute;
    top: 50%; right: var(--s7);
    transform: translateY(-50%);
    width: 88px; height: 88px;
    color: var(--line-strong);
    opacity: 0.9;
  }

  /* Einmaliger Sweep beim Laden */
  .sweep {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgba(255, 176, 0, 0.05), transparent);
    transform: translateX(-120%);
    animation: sweep 1100ms var(--ease) 180ms 1 forwards;
  }
  @keyframes sweep {
    to { transform: translateX(350%); }
  }

  .inner { position: relative; max-width: 62ch; }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    padding: 4px 8px;
    border: 1px solid currentColor;
    margin-bottom: var(--s5);
  }
  .t-ok    { color: var(--gps); }
  .t-warn  { color: var(--accent); }
  .t-alert { color: var(--armed); }
  .dot { width: 6px; height: 6px; background: currentColor; }

  h1 {
    font-size: var(--fs-display);
    letter-spacing: -0.025em;
  }
  .sub {
    margin-top: var(--s4);
    color: var(--muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
  }
  .actions {
    margin-top: var(--s6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  @media (max-width: 900px) {
    .cross { display: none; }
  }
  @media (max-width: 600px) {
    .hero { padding: var(--s6) var(--s4); }
    h1 { font-size: 1.875rem; }
    .sub { font-size: var(--fs-body); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep { display: none; }
  }
</style>
