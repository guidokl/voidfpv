---
import { NAV, type NavTab } from '~/lib/nav';
import { href, isActive, fmtDuration, fmtIso } from '~/lib/format';
import { getStats } from '~/lib/stats';

interface Props {
  /** Unterpunkte der aktuell aktiven Seite — ersetzt den frueheren Top-Tab-Streifen */
  activeTabs?: NavTab[];
}
const { activeTabs } = Astro.props;

const stats = await getStats();
const current = Astro.url.pathname;
const resolveTab = (h: string) => (h.startsWith('#') ? h : href(h));
---

<nav class="rail" id="rail" aria-label="Hauptnavigation">
  <a class="brand" href={href('/')}>
    <span class="brand-mark">NEAP<span class="slash">//</span>FPV</span>
    <span class="brand-sub">Avata 2 · Einstieg 2026</span>
  </a>

  <div class="groups">
    {
      NAV.map((group) => (
        <div class="group">
          <div class="group-label">{group.label}</div>
          <ul>
            {group.items.map((item) => {
              const active = isActive(current, item.path);
              const tabs = active ? activeTabs : undefined;
              const hasTabs = !!tabs && tabs.length > 0;
              return (
                <li class="nav-li">
                  <div class="item-row">
                    <a
                      href={href(item.path)}
                      class:list={['item', active && 'is-active']}
                      aria-current={active ? 'page' : undefined}
                      title={item.blurb}
                    >
                      <span class="idx">{item.index}</span>
                      <span class="label">{item.label}</span>
                    </a>
                    {hasTabs && (
                      <button
                        type="button"
                        class="caret"
                        data-subnav-toggle
                        aria-expanded="true"
                        aria-label={`Unterpunkte von ${item.label}`}
                      >
                        <span class="chev" aria-hidden="true"></span>
                      </button>
                    )}
                  </div>
                  {hasTabs && (
                    <ul class="subnav" data-subnav>
                      {tabs!.map((t) => (
                        <li>
                          <a class="sub-item" data-sub-link href={resolveTab(t.href)}>
                            {t.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="rail-foot">
    <div class="foot-row"><span>Flüge</span><b>{stats.flights}</b></div>
    <div class="foot-row"><span>Sim</span><b>{fmtDuration(stats.simMinutes)}</b></div>
    <div class="foot-row"><span>Papiere</span><b>{stats.legal.done}/{stats.legal.total}</b></div>
    <div class="foot-row build"><span>Build</span><b>{fmtIso(stats.buildDate)}</b></div>
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--rail-w);
    z-index: var(--z-rail);
    display: flex;
    flex-direction: column;
    background: var(--bg-deep);
    border-right: 1px solid var(--line);
  }

  /* --- Brand --- */
  .brand {
    display: block;
    padding: var(--s4) var(--s5);
    border-bottom: 1px solid var(--line);
    border-bottom-style: solid;
    color: var(--text);
  }
  .brand:hover { border-bottom-color: var(--line); }
  .brand-mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
  }
  .slash { color: var(--accent); margin: 0 0.1em; }
  .brand-sub {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
    color: var(--muted-deep);
  }

  /* --- Gruppen --- */
  .groups {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s4) 0 var(--s5);
    scrollbar-width: thin;
  }
  .group + .group { margin-top: var(--s5); }
  .group-label {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 0 var(--s5) var(--s2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--muted-deep);
  }
  .group-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-faint);
  }
  ul { list-style: none; margin: 0; padding: 0; }

  .item-row { display: flex; align-items: stretch; }
  .item {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    gap: var(--s3);
    padding: 7px var(--s5);
    border-bottom: none;
    color: var(--muted);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .item:hover { color: var(--text); background: var(--panel-hi); }

  /* --- Aufklappbares Submenue: ersetzt den frueheren Top-Tab-Streifen --- */
  .caret {
    display: grid;
    place-items: center;
    width: 28px;
    flex: none;
    color: var(--muted-deep);
    transition: color var(--dur) var(--ease);
  }
  .caret:hover { color: var(--accent); }
  .chev {
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--dur) var(--ease);
  }
  .caret[aria-expanded='false'] .chev { transform: rotate(-45deg); }

  .subnav {
    list-style: none;
    margin: 0;
    padding: 2px 0 6px;
  }
  .subnav[hidden] { display: none; }
  .sub-item {
    display: block;
    padding: 5px var(--s5) 5px calc(var(--s5) + 20px);
    color: var(--muted-deep);
    border-bottom: none;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
    border-left: 2px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .sub-item:hover { color: var(--text); }
  .sub-item.is-current { color: var(--accent); border-left-color: var(--accent); }

  .idx {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted-deep);
    padding: 2px 3px;
    min-width: 20px;
    text-align: center;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-tiny);
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
  }

  /* Aktiver Eintrag: Amber-Balken links, invertierter Index-Chip */
  .item.is-active {
    color: var(--text);
    background: var(--accent-wash);
  }
  .item.is-active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--accent);
  }
  .item.is-active .idx {
    background: var(--accent);
    color: #000;
    font-weight: 600;
  }

  /* --- Fuss: berechnete Telemetrie --- */
  .rail-foot {
    border-top: 1px solid var(--line);
    padding: var(--s3) var(--s5) var(--s4);
    background: var(--bg-deep);
  }
  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
    padding: 2px 0;
    color: var(--muted-deep);
  }
  .foot-row b { color: var(--text-dim); font-weight: 500; }
  .foot-row.build b { color: var(--muted-deep); }

  /* Mobile: Rail wird zum Drawer. Der Zustand hängt als Klasse am Element selbst —
     ein :global(body.nav-open)-Selektor über die Komponentengrenze hinweg greift
     durch das Scoping nicht zuverlässig. */
  @media (max-width: 900px) {
    .rail {
      transform: translateX(-100%);
      transition: transform var(--dur) var(--ease);
      width: min(280px, 82vw);
      z-index: var(--z-drawer);
      box-shadow: 1px 0 0 var(--line-strong);
    }
    .rail.is-open { transform: translateX(0); }
  }
</style>

<script>
  // Aufklappbares Submenue statt des frueheren Top-Tab-Streifens.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-subnav-toggle]')) {
    btn.addEventListener('click', () => {
      const sub = btn.closest('.nav-li')?.querySelector<HTMLElement>('[data-subnav]');
      if (!sub) return;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      sub.hidden = expanded;
    });
  }

  // Markiert den Unterpunkt, dessen Abschnitt gerade im Blick ist — nur fuer
  // Anker-Links (#...) auf der aktuellen Seite, externe Unterseiten bleiben unberuehrt.
  const subLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-sub-link]'),
  ).filter((a) => a.getAttribute('href')?.startsWith('#'));

  if (subLinks.length) {
    const map = new Map<string, HTMLAnchorElement>();
    const targets: Element[] = [];
    for (const a of subLinks) {
      const id = a.getAttribute('href')!.slice(1);
      const el = document.getElementById(id);
      if (el) {
        map.set(id, a);
        targets.push(el);
      }
    }

    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const firstVisible = targets.find((t) => visible.has(t.id));
        for (const [id, a] of map) a.classList.toggle('is-current', id === firstVisible?.id);
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
