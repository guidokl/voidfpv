---
/** Kennzahl-Kachel: grosse Mono-Zahl, Einheit klein, Label darunter. */
interface Props {
  value: string | number;
  unit?: string;
  label: string;
  hint?: string;
  tone?: 'default' | 'accent' | 'ok' | 'alert' | 'idle';
  size?: 'md' | 'lg';
}
const { value, unit, label, hint, tone = 'default', size = 'md' } = Astro.props;
---

<div class:list={['tile', `t-${tone}`, `sz-${size}`]}>
  <span class="tick" aria-hidden="true"></span>
  <div class="val">
    <span class="num">{value}</span>{unit && <span class="unit">{unit}</span>}
  </div>
  <div class="lbl mono-label">{label}</div>
  {hint && <div class="hint">{hint}</div>}
</div>

<style>
  .tile {
    position: relative;
    padding: var(--s4) var(--s4) var(--s4) var(--s5);
    background: var(--panel);
    border: 1px solid var(--line);
    min-width: 0;
  }
  .tick {
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--line-strong);
  }
  .t-accent .tick { background: var(--accent); }
  .t-ok .tick     { background: var(--gps); }
  .t-alert .tick  { background: var(--armed); }
  .t-idle .tick   { background: var(--muted-deep); }

  .val {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .sz-md .num { font-size: 1.75rem; }
  .sz-lg .num { font-size: var(--fs-readout); }

  .t-accent .num { color: var(--accent); }
  .t-ok .num     { color: var(--gps); }
  .t-alert .num  { color: var(--armed); }
  .t-idle .num   { color: var(--muted); }

  .unit {
    font-size: var(--fs-tiny);
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
    color: var(--muted);
  }

  .lbl { margin-top: var(--s3); display: block; }
  .hint {
    margin-top: var(--s1);
    font-size: var(--fs-tiny);
    color: var(--muted-deep);
    line-height: var(--lh-snug);
  }
</style>
