---
import type { NavTab } from '~/lib/nav';
import { href } from '~/lib/format';

interface Props {
  tabs: NavTab[];
}
const { tabs } = Astro.props;
const resolve = (h: string) => (h.startsWith('#') ? h : href(h));
---

<div class="tabbar-wrap">
  <nav class="tabbar scroll-x" aria-label="Abschnitte dieser Seite">
    {
      tabs.map((t, i) => (
        <a href={resolve(t.href)} class="tab" data-tab-link>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          {t.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .tabbar-wrap {
    position: sticky;
    top: var(--topbar-h);
    z-index: calc(var(--z-topbar) - 1);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .tabbar {
    display: flex;
    align-items: stretch;
    height: var(--tabbar-h);
    padding: 0 var(--s5);
    gap: 0;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: 0 var(--s4);
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .tab:first-child { padding-left: 0; }
  .tab:hover { color: var(--text); }
  .tab.is-current { color: var(--accent); border-bottom-color: var(--accent); }

  .n { color: var(--muted-deep); font-size: 0.625rem; }
  .tab.is-current .n { color: var(--accent-dim); }

  @media (max-width: 900px) {
    .tabbar { padding: 0 var(--s4); }
    .tab:first-child { padding-left: 0; }
  }
</style>

<script>
  // Markiert den Tab, dessen Abschnitt gerade im Blick ist.
  // Reine Zutat: ohne JS funktionieren die Ankerlinks trotzdem.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]'),
  ).filter((a) => a.getAttribute('href')?.startsWith('#'));

  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    const targets: Element[] = [];

    for (const a of links) {
      const id = a.getAttribute('href')!.slice(1);
      const el = document.getElementById(id);
      if (el) {
        map.set(id, a);
        targets.push(el);
      }
    }

    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const firstVisible = targets.find((t) => visible.has(t.id));
        for (const [id, a] of map) a.classList.toggle('is-current', id === firstVisible?.id);
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );

    targets.forEach((t) => io.observe(t));
  }
</script>
