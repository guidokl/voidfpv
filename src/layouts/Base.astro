---
import '~/styles/global.css';
import Rail from '~/components/Rail.astro';
import TopBar from '~/components/TopBar.astro';
import TabBar from '~/components/TabBar.astro';
import { findNavItem, findNavGroup, normalizePath } from '~/lib/nav';
import { href } from '~/lib/format';

interface Props {
  /** Seitentitel im Browser-Tab und in der Brotkrume */
  title: string;
  description: string;
  /** Pfad ohne base — bestimmt Rail-Aktivzustand und Tabs */
  path?: string;
  /** Ueberschreibt die Tabs aus nav.ts */
  tabs?: { label: string; href: string }[];
  /** Detailseiten: Titel in der Krume, aber Tabs der Elternseite unterdruecken */
  hideTabs?: boolean;
}

const { title, description, path, tabs, hideTabs = false } = Astro.props;

const navPath = path ?? normalizePath(
  Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/+$/, ''), '') || '/',
);
const item = findNavItem(navPath);
const group = findNavGroup(navPath);
const activeTabs = hideTabs ? undefined : (tabs ?? item?.tabs);

const fullTitle = navPath === '/' ? 'NEAP FPV — Flight Deck' : `${title} · NEAP FPV`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090b" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
  </head>

  <body>
    <a class="skip-link" href="#main">Zum Inhalt</a>

    <Rail />
    <div class="scrim" data-nav-close aria-hidden="true"></div>

    <div class="shell">
      <TopBar group={group?.label} title={title} />
      {activeTabs && activeTabs.length > 0 && <TabBar tabs={activeTabs} />}

      <main id="main" class="main">
        <slot />
      </main>

      <footer class="foot">
        <div class="foot-inner">
          <span class="mono-label">NEAP//FPV · privates Logbuch, kein kommerzielles Angebot</span>
          <nav class="foot-links">
            <a href={href('/impressum')}>Impressum</a>
            <a href={href('/datenschutz')}>Datenschutz</a>
            <a href="https://github.com/guidokl/voidfpv" rel="noopener">Quellcode</a>
          </nav>
        </div>
      </footer>
    </div>

    <script>
      // Mobile-Drawer. Bewusst winzig und ohne Abhaengigkeiten.
      const body = document.body;
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const scrim = document.querySelector<HTMLElement>('[data-nav-close]');

      // Die Zustandsklasse sitzt auf den Elementen selbst, nicht nur auf <body>:
      // scoped styles machen einen komponentenübergreifenden Selektor unzuverlässig.
      const rail = document.querySelector<HTMLElement>('#rail');

      const setOpen = (open: boolean) => {
        body.classList.toggle('nav-open', open);
        rail?.classList.toggle('is-open', open);
        scrim?.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };

      toggle?.addEventListener('click', () => setOpen(!body.classList.contains('nav-open')));
      scrim?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
      // Nach einem Sprung auf eine andere Seite schliesst sich der Drawer von selbst,
      // beim Ankerklick innerhalb der Seite müssen wir nachhelfen.
      document.querySelector('#rail')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
    </script>

    <style>
      .shell {
        margin-left: var(--rail-w);
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      .main {
        flex: 1;
        width: 100%;
        max-width: var(--content-max);
        padding: var(--s7) var(--s5) var(--s9);
        margin: 0 auto;
      }

      .foot {
        border-top: 1px solid var(--line);
        background: var(--bg-deep);
      }
      .foot-inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--s5);
        display: flex;
        flex-wrap: wrap;
        gap: var(--s4);
        justify-content: space-between;
        align-items: center;
      }
      .foot-links {
        display: flex;
        gap: var(--s5);
        font-family: var(--font-mono);
        font-size: var(--fs-micro);
        letter-spacing: var(--tr-mid);
        text-transform: uppercase;
      }
      .foot-links a { color: var(--muted); border-bottom-color: transparent; }
      .foot-links a:hover { color: var(--accent); border-bottom-color: var(--accent); }

      .scrim {
        position: fixed;
        inset: 0;
        z-index: calc(var(--z-drawer) - 1);
        background: rgba(0, 0, 0, 0.6);
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--dur) var(--ease);
      }

      @media (max-width: 900px) {
        .shell { margin-left: 0; }
        .main { padding: var(--s6) var(--s4) var(--s8); }
        .scrim.is-open { opacity: 1; pointer-events: auto; }
        :global(body.nav-open) { overflow: hidden; }
      }
    </style>
  </body>
</html>
