---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { href, fmtDate } from '~/lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  return posts
    .filter((p) => !p.data.draft)
    .map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.excerpt} path="/berichte" hideTabs>
  {
    d.template && (
      <p class="tpl">
        <span class="mono-label">Vorlage</span>
        Beispieltext, der zeigt, wie ein Bericht aufgebaut sein kann.
      </p>
    )
  }

  <header class="head">
    <a class="back mono-label" href={href('/berichte')}>&larr; Berichte</a>
    <time class="mono-label" datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
    <h1>{d.title}</h1>
    <p class="excerpt">{d.excerpt}</p>
    {
      d.tags.length > 0 && (
        <div class="tags">
          {d.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }
    <div class="rule" aria-hidden="true"></div>
  </header>

  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .tpl {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    padding: var(--s3) var(--s4);
    margin-bottom: var(--s5);
    border-left: 2px solid var(--accent);
    background: var(--accent-wash);
    font-size: var(--fs-small);
    color: var(--text-dim);
  }
  .head { margin-bottom: var(--s6); }
  .back { display: block; margin-bottom: var(--s4); border-bottom: none; color: var(--muted); }
  .back:hover { color: var(--accent); }
  h1 { margin-top: var(--s2); font-size: var(--fs-h1); max-width: 24ch; }
  .excerpt {
    margin-top: var(--s3);
    max-width: 66ch;
    color: var(--muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
  }
  .tags { margin-top: var(--s4); display: flex; gap: var(--s2); flex-wrap: wrap; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted-deep);
    border: 1px solid var(--line);
    padding: 1px 5px;
  }
  .rule {
    margin-top: var(--s5);
    height: 1px;
    background-image: linear-gradient(to right, var(--line-strong) 2px, transparent 2px);
    background-size: 6px 1px;
  }
</style>
