---
import Base from '~/layouts/Base.astro';
import Panel from '~/components/Panel.astro';
import { href } from '~/lib/format';

const THIRD_PARTY = [
  {
    name: 'GitHub Pages',
    who: 'GitHub, Inc. / Microsoft',
    when: 'bei jedem Seitenaufruf',
    what: 'IP-Adresse, Zeitpunkt, aufgerufene Adresse, Browserkennung — technisch nötig zur Auslieferung',
    url: 'https://docs.github.com/de/site-policy/privacy-policies/github-general-privacy-statement',
  },
  {
    name: 'Open-Meteo',
    who: 'Open-Meteo, Bruggstrasse 7, 6318 Walchwil, Schweiz',
    when: 'nur im Bereich Wetter, erst nach Auswahl eines Standorts',
    what: 'die abgefragten Koordinaten und die IP-Adresse des Browsers',
    url: 'https://open-meteo.com/en/terms',
  },
  {
    name: 'NOAA SWPC',
    who: 'National Oceanic and Atmospheric Administration, USA',
    when: 'nur im Bereich Wetter, zusammen mit der Wetterabfrage',
    what: 'IP-Adresse — es werden keine Standortdaten übertragen, der Kp-Index gilt global',
    url: 'https://www.weather.gov/privacy',
  },
];
---

<Base
  title="Datenschutz"
  description="Datenschutzerklärung für voidfpv: welche Daten verarbeitet werden, welche externen Dienste beteiligt sind und was im Browser gespeichert wird."
  path="/datenschutz"
  hideTabs
>
  <header class="head">
    <span class="mono-label">Rechtliches</span>
    <h1>Datenschutz</h1>
    <p class="lead">
      Diese Seite kommt ohne Tracking, ohne Analyse-Werkzeuge, ohne Werbung und ohne Cookies
      aus. Deshalb gibt es auch kein Einwilligungsbanner — es gäbe nichts einzuwilligen.
    </p>
    <div class="rule" aria-hidden="true"></div>
  </header>

  <Panel label="Verantwortlicher">
    <dl class="fields">
      <div><dt>Name</dt><dd>Guido Kleine</dd></div>
      <div><dt>Anschrift</dt><dd>Zur Eckernheide 10, 48157 Münster</dd></div>
      <div><dt>E-Mail</dt><dd><a href="mailto:guidokl@pm.me">guidokl@pm.me</a></dd></div>
    </dl>
  </Panel>

  <Panel label="Was diese Seite nicht tut" tone="ok">
    <ul class="no-list">
      <li>kein Analyse- oder Statistikwerkzeug</li>
      <li>keine Cookies</li>
      <li>keine Werbung, kein Affiliate-Tracking</li>
      <li>keine Schriftarten von externen Servern — alle Fonts liegen lokal</li>
      <li>keine eingebetteten Videos oder Social-Media-Elemente</li>
      <li>keine Kontaktformulare, keine Kommentarfunktion</li>
      <li>keine Weitergabe von Daten zu Werbezwecken</li>
    </ul>
  </Panel>

  <Panel label="Externe Dienste" meta="vollständige Liste">
    <p class="txt">
      Nur diese drei Stellen können beim Besuch der Seite Daten sehen. Zwei davon erst, wenn im
      Wetter-Bereich aktiv ein Standort gewählt wurde.
    </p>
    <div class="services">
      {
        THIRD_PARTY.map((s) => (
          <article class="svc">
            <header>
              <h3>{s.name}</h3>
              <a href={s.url} target="_blank" rel="noopener noreferrer">Datenschutzhinweise</a>
            </header>
            <dl>
              <div><dt>Anbieter</dt><dd>{s.who}</dd></div>
              <div><dt>Wann</dt><dd>{s.when}</dd></div>
              <div><dt>Was</dt><dd>{s.what}</dd></div>
            </dl>
          </article>
        ))
      }
    </div>
    <p class="txt small">
      Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO — das berechtigte Interesse an einer
      technisch funktionierenden Seite. Die Wetterabfrage erfolgt zusätzlich nur auf aktive
      Handlung hin.
    </p>
  </Panel>

  <Panel label="Standort">
    <p class="txt">
      Im Bereich <a href={href('/wetter')}>Wetter</a> lässt sich ein Standort angeben — als
      Koordinaten, als gespeicherter Spot oder über die Standortfunktion des Browsers. Letztere
      wird <strong>ausschließlich auf Klick</strong> ausgelöst und fragt vorher die Erlaubnis
      des Browsers ab.
    </p>
    <p class="txt">
      Die Position wird als Teil der Wetterabfrage an Open-Meteo übertragen. Sie wird nicht an
      den Betreiber dieser Seite gesendet, nicht protokolliert und nicht gespeichert — außer
      lokal im Browser, damit beim nächsten Besuch derselbe Ort vorausgewählt ist.
    </p>
  </Panel>

  <Panel label="Speicher im Browser">
    <p class="txt">
      Es werden keine Cookies gesetzt. Verwendet werden zwei Browser-Speicher, die den eigenen
      Rechner nie verlassen:
    </p>
    <dl class="fields">
      <div>
        <dt><code>localStorage</code></dt>
        <dd>
          Stand der Checklisten und der zuletzt gewählte Wetter-Standort. Bleibt bis zum Löschen
          der Website-Daten erhalten.
        </dd>
      </div>
      <div>
        <dt><code>sessionStorage</code></dt>
        <dd>
          Zwischenspeicher der Wetterdaten für zehn Minuten, damit nicht bei jedem Klick neu
          abgefragt wird. Wird beim Schließen des Tabs geleert.
        </dd>
      </div>
    </dl>
    <p class="txt small">
      Beides lässt sich jederzeit über die Browser-Einstellungen löschen. Die Seite funktioniert
      danach unverändert, merkt sich nur nichts mehr.
    </p>
  </Panel>

  <Panel label="Server-Logfiles">
    <p class="txt">
      Die Seite wird über GitHub Pages ausgeliefert. Dabei fallen beim Anbieter technisch
      bedingt Zugriffsdaten an — IP-Adresse, Zeitpunkt, aufgerufene Adresse, Browserkennung.
      Auf diese Daten besteht kein Zugriff durch den Betreiber dieser Seite; sie werden nicht
      ausgewertet.
    </p>
  </Panel>

  <Panel label="Rechte der betroffenen Personen">
    <p class="txt">
      Es gelten die Rechte nach DSGVO: Auskunft (Art. 15), Berichtigung (Art. 16), Löschung
      (Art. 17), Einschränkung (Art. 18), Datenübertragbarkeit (Art. 20) und Widerspruch
      (Art. 21). Da diese Seite selbst keine personenbezogenen Daten speichert, richten sich
      Anfragen zu Zugriffsdaten an den jeweiligen Dienst oben. Für alles Übrige gilt die
      Kontaktadresse im <a href={href('/impressum')}>Impressum</a>.
    </p>
    <p class="txt">
      Zudem besteht ein Beschwerderecht bei einer Datenschutz-Aufsichtsbehörde.
    </p>
  </Panel>

  <Panel label="Bilder und Personen">
    <p class="txt">
      Auf dieser Seite veröffentlichte Luftaufnahmen werden vor der Veröffentlichung geprüft:
      Standortdaten werden aus den Dateien entfernt, erkennbare Personen nur mit Einwilligung
      gezeigt. Wer sich dennoch auf einer Aufnahme erkennt und deren Entfernung wünscht, kann
      sich über die Adresse im Impressum melden — sie wird dann entfernt, ohne Rückfrage nach
      dem Grund.
    </p>
  </Panel>
</Base>

<style>
  .head { margin-bottom: var(--s6); }
  h1 { margin-top: var(--s2); font-size: var(--fs-h1); }
  .lead { margin-top: var(--s3); max-width: 68ch; color: var(--muted); font-size: var(--fs-lead); line-height: var(--lh-snug); }
  .rule {
    margin-top: var(--s5);
    height: 1px;
    background-image: linear-gradient(to right, var(--line-strong) 2px, transparent 2px);
    background-size: 6px 1px;
  }

  .todo { display: flex; flex-direction: column; gap: var(--s1); font-size: var(--fs-small); color: var(--text-dim); }
  .txt { font-size: var(--fs-small); color: var(--muted); max-width: 78ch; }
  .txt + .txt { margin-top: var(--s3); }
  .txt.small { margin-top: var(--s4); font-size: var(--fs-tiny); color: var(--muted-deep); }

  .fields { display: grid; }
  .fields > div {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s4);
    padding: var(--s3) 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .fields > div:last-child { border-bottom: none; }
  dt { font-size: var(--fs-small); color: var(--muted); }
  dd { font-size: var(--fs-small); color: var(--text-dim); }
  .fill { color: var(--armed); font-family: var(--font-mono); }

  .no-list { list-style: none; margin: 0; padding: 0; }
  .no-list li {
    position: relative;
    padding: var(--s2) 0 var(--s2) var(--s5);
    font-size: var(--fs-small);
    color: var(--text-dim);
    border-bottom: 1px solid var(--line-faint);
  }
  .no-list li:last-child { border-bottom: none; }
  .no-list li::before {
    content: '×';
    position: absolute;
    left: var(--s2);
    color: var(--gps);
  }

  .services { display: grid; gap: var(--s3); margin-top: var(--s4); }
  .svc {
    padding: var(--s4);
    background: var(--panel-sunk);
    border: 1px solid var(--line);
    border-left: 2px solid var(--line-strong);
  }
  .svc header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    flex-wrap: wrap;
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--line-faint);
  }
  .svc h3 { font-size: var(--fs-body); }
  .svc header a { font-family: var(--font-mono); font-size: var(--fs-micro); }
  .svc dl { margin-top: var(--s3); display: grid; gap: var(--s2); }
  .svc dl > div { display: grid; grid-template-columns: 90px 1fr; gap: var(--s3); }
  .svc dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mid);
    text-transform: uppercase;
    color: var(--muted-deep);
  }
  .svc dd { font-size: var(--fs-small); color: var(--muted); }

  @media (max-width: 620px) {
    .fields > div, .svc dl > div { grid-template-columns: 1fr; gap: var(--s1); }
  }
</style>
