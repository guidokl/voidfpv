---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Panel from '~/components/Panel.astro';
import StatTile from '~/components/StatTile.astro';
import StatusLed from '~/components/StatusLed.astro';
import EmptyState from '~/components/EmptyState.astro';
import { getStats } from '~/lib/stats';
import { href, fmtDuration, fmtDate } from '~/lib/format';
import { LERNPFAD } from '~/data/lernpfad';
import { getCollection } from 'astro:content';

const stats = await getStats();

const status = (await getCollection('status')).sort((a, b) => a.data.order - b.data.order);
const openSteps = status.filter((s) => s.data.state !== 'done');
const nextStep = openSteps.find((s) => s.data.state === 'open') ?? openSteps[0];

const sims = (await getCollection('sim'))
  .filter((s) => !s.data.template)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const lastSim = sims[0];

const activePhases = LERNPFAD.filter((p) => p.state === 'active');
---

<Base
  title="Status"
  description="Persönliches FPV-Logbuch: Einstieg mit der DJI Avata 2 — Status, Hardware, Wetter-Briefing, Wissen und Flugbuch."
  path="/"
>
  <Hero
    status="Pre-Flight · Hardware im Zulauf"
    statusTone="warn"
    headline="Noch kein Flug. Aber schon ein Plan."
    sub="Avata 2, Goggles 3 und der FPV-Controller sind bestellt. Bis sie da sind, läuft alles, was ohne Fluggerät geht: Papierkram, Simulator, Spots. Diese Seite ist das Logbuch dazu — von der ersten Rechnung bis zum ersten Wald."
  >
    <a class="btn" href={href('/papierkram')}>Papierkram &rarr;</a>
    <a class="btn" href={href('/wetter')}>Wetter-Briefing</a>
    <a class="btn" href={href('/wissen')}>Wissensbasis</a>
  </Hero>

  <div class="tiles">
    <StatTile value={stats.flights} label="Flüge" tone="idle" hint="Startet mit der Lieferung" />
    <StatTile
      value={stats.simMinutes === 0 ? '0' : fmtDuration(stats.simMinutes)}
      label="Simulator"
      tone={stats.simMinutes > 0 ? 'accent' : 'idle'}
      hint={`Ziel vor dem ersten Manual-Akku: 15–20 h`}
    />
    <StatTile
      value={`${stats.legal.done}/${stats.legal.total}`}
      label="Formalitäten"
      tone={stats.legal.done === stats.legal.total ? 'ok' : 'alert'}
      hint="Versicherung zuerst, dann LBA"
    />
    <StatTile value={stats.spots} label="Spots geprüft" tone="idle" hint="dipul-Status je Ort" />
  </div>

  <div class="cols">
    <Panel label="Nächster Schritt" meta="Reihenfolge zählt">
      {
        nextStep ? (
          <div class="next">
            <h2>{nextStep.data.label}</h2>
            <p>{nextStep.data.note}</p>
            <div class="next-meta">
              {nextStep.data.costEur && (
                <span class="mono-label">Kosten · {nextStep.data.costEur}</span>
              )}
              {nextStep.data.url && (
                <a class="btn" href={nextStep.data.url} rel="noopener" target="_blank">
                  Zur Quelle
                </a>
              )}
            </div>
          </div>
        ) : (
          <p class="muted">Alles erledigt. Zeit zu fliegen.</p>
        )
      }
    </Panel>

    <Panel label="Formalitäten" meta={`${stats.legal.done} von ${stats.legal.total}`}>
      <ul class="steps">
        {
          status.map((s) => (
            <li>
              <StatusLed state={s.data.state} />
              <span class="step-label">{s.data.label}</span>
              <span class="step-cost">{s.data.costEur ?? ''}</span>
            </li>
          ))
        }
      </ul>
      <a class="btn full" href={href('/papierkram')}>Details und Reihenfolge</a>
    </Panel>
  </div>

  <Panel label="Simulator" meta={`${stats.simSessions} Sessions`}>
    {
      lastSim ? (
        <div class="sim-last">
          <div>
            <span class="mono-label">Letzte Session</span>
            <h3>{lastSim.data.sim}</h3>
            <p class="muted">{lastSim.data.focus.join(' · ')}</p>
          </div>
          <div class="sim-num">
            <span class="readout">
              {Math.round(lastSim.data.minutes)}
              <span class="unit">min</span>
            </span>
            <span class="mono-label">{fmtDate(lastSim.data.date)}</span>
          </div>
        </div>
      ) : (
        <EmptyState
          code="SIM 00"
          title="Noch keine Simulator-Session erfasst"
          reason="Der FPV Remote Controller 3 ist bestellt. Sobald er per USB am Rechner hängt, beginnt das eigentliche Training — lange bevor die Drohne über einem Feld steht."
          next="Uncrashed oder Liftoff installieren, Rates grob an die Avata anpassen, erste Hover-Übung eintragen."
        />
      )
    }
    <a class="btn full" href={href('/sim')}>Trainingsplan und Sim-Vergleich</a>
  </Panel>

  <Panel label="Lernpfad" meta="Phase 00 und 01 laufen">
    <div class="phases">
      {
        activePhases.map((p) => (
          <article class="phase">
            <span class="p-idx">{p.index}</span>
            <div>
              <h3>{p.title}</h3>
              <p class="muted">{p.goal}</p>
              <p class="p-done">
                <span class="mono-label">Sitzt, wenn</span>
                {p.done}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <a class="btn full" href={`${href('/wissen')}#lernpfad`}>Alle sechs Phasen</a>
  </Panel>
</Base>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s3);
    margin-bottom: var(--s5);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s3);
    margin-bottom: var(--s5);
    align-items: start;
  }

  .next h2 { font-size: var(--fs-h3); }
  .next p { margin-top: var(--s3); color: var(--muted); font-size: var(--fs-small); }
  .next-meta {
    margin-top: var(--s5);
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-wrap: wrap;
  }

  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s3);
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .step-label { font-size: var(--fs-small); color: var(--text-dim); }
  .step-cost {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--muted-deep);
    white-space: nowrap;
  }

  .btn.full {
    display: flex;
    justify-content: center;
    margin-top: var(--s5);
    width: 100%;
  }

  .sim-last {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s5);
    flex-wrap: wrap;
  }
  .sim-last h3 { margin-top: var(--s2); }
  .sim-num { text-align: right; display: grid; gap: var(--s2); }

  .phases { display: grid; gap: var(--s4); }
  .phase {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s4);
    padding: var(--s4);
    background: var(--panel-sunk);
    border-left: 2px solid var(--accent);
  }
  .p-idx {
    font-family: var(--font-mono);
    font-size: var(--fs-tiny);
    color: var(--accent);
  }
  .phase h3 { font-size: var(--fs-body); }
  .phase p { font-size: var(--fs-small); margin-top: var(--s2); }
  .p-done {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--text-dim);
  }

  .muted { color: var(--muted); }

  @media (max-width: 820px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
